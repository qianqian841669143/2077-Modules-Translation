# Python
__pycache__/
*.py[cod]
.venv/
venv/

# PyInstaller 产物目录
build/
dist/
# 例外：构建配置本身要入库，否则换台机器没法复现打包
*.spec
!2077ModTranslator.spec

# 运行时产物
*.bak
# 改动前的备份（统一命名 *.bak-<日期>-<时分>），只留本地，不入库
*.bak-*
src/_bak/
userdata/
*.log

# M0 探针工作目录（解包结果 + 中间产物，可重建）
.m0/

# 资源模式工作目录（解包 + 中间产物，可重建）
.l10n/

# 历史版本压缩包（旧发布件，体积大且可重新打包）
backup/

# 一次性补丁脚本（已应用完毕，只作留档，不参与构建）
src/tmp_wa1.py
src/tmp_wa2.py

# 编辑器
# .vscode 只共享这三份：dev 热更新的启动配置、打包任务、解释器路径
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/

# 临时目录：截图 / 设计稿草样，不进仓库
_tmp/
